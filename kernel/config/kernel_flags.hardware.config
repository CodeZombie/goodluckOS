# All the kernel config options needed to run on real hardware

CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="root=/dev/mmcblk0p1 rootfstype=ext4 rootwait rw init=/sbin/init coherent_pool=4m loglevel=8"
CONFIG_CMDLINE_FORCE=y
CONFIG_GPIO_SYSFS=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I=y
CONFIG_POWER_SUPPLY=y
CONFIG_SUNXI_RSB=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_AXP20X_POWER=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_BATTERY_AXP20X=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_SND_SUN8I_CODEC=y
CONFIG_DRM_SUN6I_MIPI_DSI=y
CONFIG_COMMON_CLK_DEBUGFS=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_DRM_LIMA=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_F_ACM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_INPUT_JOYDEV=y
CONFIG_IIO=y
CONFIG_MFD_SUN4I_GPADC=y
CONFIG_SUN4I_GPADC=y
CONFIG_SUN8I_THERMAL=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN8I_CODEC_ANALOG=y
CONFIG_KEYBOARD_SUN4I_LRADC=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_DRM_PANEL_JD9366=y
CONFIG_GA36MB_GAMEPAD=y
