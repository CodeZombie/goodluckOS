#!/bin/sh

G=/sys/kernel/config/usb_gadget/g1
LOG=/tmp/usb-gadget.log

# Rebuild the gadget with the serial console alone (MTP did not work)
serial_only() {
    echo "$1: serial only" >> $LOG
    [ -f /run/umtprd.pid ] && kill "$(cat /run/umtprd.pid)" 2>/dev/null && rm -f /run/umtprd.pid
    echo "" > $G/UDC 2>/dev/null
    rm -f $G/configs/c.1/ffs.mtp
    ls /sys/class/udc > $G/UDC
}

case "$1" in
  start)
    echo "Starting USB Gadget (serial + MTP)..."

    mount -t configfs none /sys/kernel/config 2>/dev/null

    cd /sys/kernel/config/usb_gadget
    mkdir -p g1
    cd g1

    # Set Vendor/Product IDs (Linux Foundation defaults)
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB

    # Composite device with interface association descriptors (needed by Windows for ACM + MTP)
    echo 0xEF > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol

    # Set English strings
    mkdir -p strings/0x409
    echo "0123456789" > strings/0x409/serialnumber
    echo "goodluckOS"  > strings/0x409/manufacturer
    echo "GA36MB" > strings/0x409/product

    # Create the configuration
    mkdir -p configs/c.1/strings/0x409
    echo "Serial + MTP" > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower

    # Serial console (ttyGS0)
    mkdir -p functions/acm.usb0
    ln -s functions/acm.usb0 configs/c.1/

    # MTP: HOME shows up on the PC as a folder. umtprd answers on FunctionFS.
    if mkdir -p functions/ffs.mtp 2>/dev/null; then
        ln -s functions/ffs.mtp configs/c.1/
        mkdir -p /dev/ffs-mtp
        mount -t functionfs mtp /dev/ffs-mtp
        umtprd >/tmp/umtprd.log 2>&1 &
        echo $! > /run/umtprd.pid
        # The gadget can only bind once umtprd has written its descriptors (the endpoints appear)
        i=0
        while [ ! -e /dev/ffs-mtp/ep1 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    fi

    # Bind the gadget to the USB Device Controller. If MTP keeps it from binding, drop MTP
    # and bind the serial console alone: losing the console is much worse than losing MTP.
    UDC_NAME=$(ls /sys/class/udc)
    if ! echo "$UDC_NAME" > UDC 2>>$LOG; then
        serial_only "bind failed"
    elif [ -L configs/c.1/ffs.mtp ]; then
        # The bind can succeed and the PC still not enumerate the device. With a cable in,
        # a working gadget reaches "configured" in a second or two; give it 15s.
        (
            sleep 15
            state=$(cat /sys/class/udc/$UDC_NAME/state)
            echo "state after 15s: $state" >> $LOG
            if [ "$(cat /sys/class/power_supply/axp20x-usb/online 2>/dev/null)" = "1" ] && [ "$state" != "configured" ]; then
                serial_only "not enumerated"
            fi
        ) &
    fi
    ;;
  stop)
    echo "Stopping USB Gadget..."

    [ -f /run/umtprd.pid ] && kill "$(cat /run/umtprd.pid)" 2>/dev/null && rm -f /run/umtprd.pid

    # With no USB cable the unbind below never returns, which hung every shutdown and reboot
    # (rcK stops here). There is nothing to tear down before the power goes off anyway.
    if [ "$(cat /sys/class/power_supply/axp20x-usb/online 2>/dev/null)" != "1" ]; then
        exit 0
    fi

    # Unbind from UDC. This can also hang with the cable in (e.g. a half-started MTP function),
    # so give it 3s and let the shutdown go on without the teardown.
    ( echo "" > $G/UDC ) &
    i=0
    while kill -0 $! 2>/dev/null; do
        [ $i -ge 30 ] && exit 0
        sleep 0.1; i=$((i + 1))
    done

    # Remove symlinks
    rm -f $G/configs/c.1/acm.usb0 $G/configs/c.1/ffs.mtp
    umount /dev/ffs-mtp 2>/dev/null

    # Remove directories in reverse order of creation
    rmdir $G/configs/c.1/strings/0x409
    rmdir $G/configs/c.1
    rmdir $G/functions/acm.usb0
    rmdir $G/functions/ffs.mtp 2>/dev/null
    rmdir $G/strings/0x409
    rmdir $G
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
