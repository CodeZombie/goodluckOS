#!/bin/sh
# Listen for power-related system commands from unprivileged users

case "$1" in
  start)
    # Create the named pipe
    mkfifo /tmp/syscmd
    chmod 666 /tmp/syscmd

    # Start a background listener
    (
      while true; do
        read -r cmd < /tmp/syscmd
        if [ "$cmd" = "poweroff" ]; then
          sync
          /sbin/poweroff
        elif [ "$cmd" = "reboot" ]; then
          sync
          /sbin/reboot
        fi
      done
    ) &
    ;;
esac
