#!/usr/bin/env luajit
-- app-cache: builds and maintains the GoodluckOS application cache (SQLite).
--
--   app-cache scan [--prune]        scan every path listed in the locations dir
--   app-cache scan <path>           scan only <path>
--   app-cache file                  print the path of the sqlite database
--   app-cache autolaunch            print the id of the autolaunch app (exit 1 if none)
--   app-cache autolaunch <id>       make <id> the autolaunch app
--   app-cache autolaunch --clear    clear the autolaunch app
--
-- This file only defines the schema and glues two libraries together:
--   libappscanner  finds entries (knows nothing about databases)
--   seekwell       stores them   (knows nothing about apps)

local argparse       = require("argparse")
local libappcachedb   = require("libappcachedb")
local libappscanner  = require("libappscanner")


-- SCAN_FIELDS lists the columns a scanner is allowed to set; any other key a
-- scanner returns goes into `metadata`.
NON_METADATA_KEYS = {
    command = true,
    path = true,
    name = true,
    description = true,
    category = true,
    icon_filepath = true,
    last_scan_id = true,
    terminal = true,
    launcher = true,
    metadata = true, -- the metadata key should not itself in the metadata
}

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function warn(msg) io.stderr:write("app-cache: warning: ", msg, "\n") end
local function die(msg)  io.stderr:write("app-cache: ", msg, "\n"); os.exit(1) end

----------------------------------------------------------------------
-- scan results -> database rows
----------------------------------------------------------------------
-- Splits a scanner's entry into real columns and `metadata`.
-- local function to_row(result, scan_id)
--     local row, meta = {}, {}
--     for k, v in pairs(result.entry) do
--         if type(k) == "string" and v ~= nil and v ~= cjson.null then
--             k = k:lower()
--             if SCAN_FIELDS[k] then row[k] = v else meta[k] = v end
--         end
--     end
--
--     local ok, err = pcall(cjson.encode, meta)
--     if not ok then
--         warn("cannot encode metadata for '" .. tostring(row.name) .. "': " .. tostring(err))
--         meta = {}
--     end
--
--     row.metadata  = meta
--     row.source    = result.source
--     row.scanner   = result.scanner
--     row.last_seen = scan_id
--     return row
-- end
local function normalize_app(raw_app)
    local normalized_app = { metadata = raw_app.metadata or {} }
    for k, v in pairs(raw_app) do
        if NON_METADATA_KEYS[k] then
            normalized_app[k] = v
        else
            normalized_app.metadata[k] = v
        end
    end
    return normalized_app
end

----------------------------------------------------------------------
-- commands
----------------------------------------------------------------------
---
---
local function do_scan(prune)
    local scanner, err = libappscanner.new({ warn = warn })
    if not scanner then die(err) end

    local scan_results, stats = scanner.scan_all()
    if not scan_results then die(stats) end   -- on failure the 2nd return is the error

    local db, db_err = libappcachedb.open()
    if not db then die(db_err) end



    local pre_scan_number_of_apps = nil
    for t in db.connection:nrows("SELECT COUNT() AS value FROM apps") do
        pre_scan_number_of_apps = t.value
    end

    local max_last_scan_id = 0
    if prune then
        for t in db.connection:nrows("SELECT COALESCE(MAX(last_scan_id), 0) AS value FROM apps") do
            max_last_scan_id = t.value
        end
    end

    for _, entry in ipairs(scan_results) do
        if prune then
            entry.last_scan_id = max_last_scan_id + 1
        end
        local normalized_app = normalize_app(entry.app)
        local err = db:upsert_row("apps", normalized_app)
        if err then
            local row_str_parts = {}
            for k, v in pairs(normalized_app) do
                table.insert(row_str_parts, string.format("%s: %s", k, v))
            end

            print("[app-cache] The following scanned entry could not be inserted into the app-cache database:")
            print(string.format("[app-cache]    Scanned Entry: %s", table.concat(row_str_parts, ", ")))
            print(string.format("[app-cache]    Error: %s", err))
        end
    end

    if prune then
        err = db.connection:exec(string.format("DELETE FROM apps WHERE last_scan_id < %d", max_last_scan_id + 1))
        if err ~= db.sqlite3.OK then die("database error: " .. err) end
    end

    local post_scan_number_of_apps = nil
    for t in db.connection:nrows("SELECT COUNT() AS value FROM apps") do
        post_scan_number_of_apps = t.value
    end

    local app_count_delta = post_scan_number_of_apps - pre_scan_number_of_apps

    print(string.format("Scanned %d file(s) with %d scanner(s).", stats.files, stats.scanners))

    local sign = ""
    if app_count_delta >= 0 then
        sign = "+"
    end
    print(string.format("Delta: %s%d total app(s)", sign, app_count_delta))
end

