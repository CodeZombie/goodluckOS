local function set_autolaunch_command(app_command)
    local db, err = libappcachedb.open()
    if not db then die(err) end
    err = db:upsert_row("autolaunch", app_command)
    db:close()
    if err then die(err) end

--     if id ~= nil then
--         local rows, err = db.query("SELECT 1 FROM apps WHERE id = ?", { id })
--         if not rows then die(err) end
--         if #rows == 0 then die("no application with id " .. id) end
--     end
--
--     err = db.transaction(function()
--         local e = db.exec("UPDATE apps SET autolaunch = 0 WHERE autolaunch = 1")
--         if e then error(e, 0) end
--         if id ~= nil then
--             e = db.exec("UPDATE apps SET autolaunch = 1 WHERE id = ?", { id })
--             if e then error(e, 0) end
--         end
--     end)
    -- db.close()
    -- if err then die("failed to set autolaunch application: " .. err) end
end

local function get_autolaunch_command()
    local db, err = libappcachedb.open()
    if not db then die(err) end

    local autolaunch_command = nil
    for t in pairs(db.connection:nrows("SELECT apps.command FROM active_launcher INNER JOIN apps ON active_launcher.app_id = apps.id;")) do
        autolaunch_command = t.command
    end
    db.close()
    return autolaunch_command
end
