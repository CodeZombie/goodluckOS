----------------------------------------------------------------------
-- CLI
----------------------------------------------------------------------
local parser = argparse("app-cache", "Builds and maintains the goodluckOS application cache.")
parser:command_target("command")

local scan_cmd = parser:command("scan", "Scan for apps and update the database.")
scan_cmd:flag("--prune", "Remove entries not seen in this scan.")

parser:command("file", "Print the path of the sqlite database.")

local autolaunch_cmd = parser:command("autolaunch", "Show or set the app that autolaunches on boot.")
autolaunch_cmd:argument("id", "The ID of the application to autolaunch."):args("?"):convert(function(s)
    local n = tonumber(s)
    if n and n >= 1 and n == math.floor(n) then return n end
    return nil, "id must be a positive integer"
end)
autolaunch_cmd:flag("--clear", "Clear the autolaunch application.")

local args = parser:parse()

if args.command == "file" then
    print(libappcachedb.DB_PATH)
elseif args.command == "autolaunch" then
    if args.clear and args.id then
        die("--clear and an id cannot be used together")
    elseif args.clear then
        set_autolaunch_command(nil)
    elseif args.id then
        set_autolaunch_command(args.id)
    else
        print(get_autolaunch_command())
    end
else
    if args.path and args.prune then
        die("--prune only makes sense for a full scan")
    end
    do_scan(args.prune)
end
