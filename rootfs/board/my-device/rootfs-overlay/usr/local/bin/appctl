#!/bin/sh
#
# /usr/local/bin/appctl  --  launcher / application supervisor
#
# Guarantees that the launcher cgroup and the application cgroup are never
# populated at the same time. Both are tracked as cgroup-v2 groups, never as
# bare PIDs, so double-forking apps and PID reuse can't confuse it.
#
# Usage:
#   appctl start | stop | restart | status
#   appctl launch-application "<shell command string>" [TERMINAL_MODE]
#       TERMINAL_MODE = 1 : the app gets the console ($CONSOLE, tty1) as stdin,
#                           stdout and stderr AND as its controlling terminal.
#                           Use for less, vim, shells, ncurses apps. Not logged.
#       anything else     : normal launch. stdin is /dev/null, stdout/stderr go to
#                           /dev/shm/application/application.log
#   appctl stop-application      SIGTERM to everything in the application cgroup
#   appctl kill-application      SIGKILL to everything in the application cgroup
#   appctl daemon          (foreground; for use with ::respawn: in inittab)
#
# Design notes:
#   * The daemon is the ONLY thing that touches cgroups / starts processes.
#     CLI verbs just drop a one-line request into a FIFO. This matters because
#     `launch-application` is normally called *from the launcher*, which lives
#     in the cgroup that is about to be killed. Doing the kill from the caller
#     would kill the caller mid-operation.
#   * Every spawned process gets a generation number. Exit events from a
#     previous generation (e.g. the launcher we just killed on purpose) are
#     ignored instead of triggering a bogus restart.
#   * Processes enter their cgroup BEFORE exec, so there is no window where a
#     fork can escape.

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# ----------------------------------------------------------------- config ---
RUN_USER=player
LAUNCHER_CMD=/home/player/.local/launcher.sh
CONSOLE=/dev/tty1                 # where the "loading" screen is drawn
RUN_DIR=/run/appd                 # FIFO + pidfile (use /dev/shm/appd if no /run)
LOG_DIR=/dev/shm/application
APP_LOG=$LOG_DIR/application.log
LAUNCHER_LOG=$LOG_DIR/launcher.log
CG_MOUNT=/sys/fs/cgroup
CG_ROOT=$CG_MOUNT/appd
MIN_LAUNCHER_UPTIME=5             # launcher dying faster than this is "crashing"
RESTART_DELAY=1                   # seconds to wait before respawning a crasher
TTY_WRAPPER="setsid -c"           # terminal mode: makes stdin the controlling tty.
                                  # If your BusyBox lacks `setsid -c`, try "setsid cttyhack"

# optional overrides
[ -r /etc/default/appd ] && . /etc/default/appd

FIFO=$RUN_DIR/control
PIDFILE=$RUN_DIR/appd.pid
SELF=$(readlink -f "$0")

# ---------------------------------------------------------------- helpers ---
log() {
    { echo "appd: $*" >/dev/kmsg; } 2>/dev/null || echo "appd: $*" >&2
}

init_timing() {
    if sleep 0.1 2>/dev/null; then PER_SEC=10; else PER_SEC=1; fi
}

nap() { sleep 0.1 2>/dev/null || sleep 1; }

uptime_s() { read -r _up _ </proc/uptime; echo "${_up%%.*}"; }

daemon_running() {
    [ -r "$PIDFILE" ] || return 1
    read -r _pid <"$PIDFILE" 2>/dev/null || return 1
    [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null
}

# one line -> daemon. Never blocks forever if the daemon is wedged/absent.
send() {
    daemon_running || { echo "appd: daemon is not running" >&2; return 1; }
    case $1 in
        *'
'*) echo "appd: newlines are not allowed in commands" >&2; return 1 ;;
    esac
    [ "${#1}" -lt 4000 ] || { echo "appd: request too long" >&2; return 1; }
    if command -v timeout >/dev/null 2>&1; then
        timeout 3 sh -c 'printf "%s\n" "$1" >"$2"' sh "$1" "$FIFO"
    else
        printf '%s\n' "$1" >"$FIFO"
    fi
}

# ----------------------------------------------------------------- cgroups ---
setup_cgroups() {
    if ! grep -q ' cgroup2 ' /proc/mounts; then
        mount -t cgroup2 none "$CG_MOUNT" || { log "cannot mount cgroup2"; return 1; }
    fi
    mkdir -p "$CG_ROOT/launcher" "$CG_ROOT/app" || return 1
}

# true if the cgroup has at least one process (file size is always 0 on
# kernfs, so we must actually read from it)
cg_populated() { read -r _x <"$1/cgroup.procs" 2>/dev/null; }

# cg_signal <dir> <signal>: send a signal to every process in the cgroup.
# Returns immediately; does not wait for anything to die.
cg_signal() {
    for _p in $(cat "$1/cgroup.procs" 2>/dev/null); do
        kill "-$2" "$_p" 2>/dev/null
    done
}

# cg_stop <dir>: SIGKILL everything in the cgroup and wait until it is empty.
# No grace period; graceful exits are requested via stop-application.
cg_stop() {
    _dir=$1
    cg_populated "$_dir" || return 0
    _n=$((5 * PER_SEC))
    while cg_populated "$_dir" && [ "$_n" -gt 0 ]; do
        if [ -w "$_dir/cgroup.kill" ]; then
            echo 1 >"$_dir/cgroup.kill" 2>/dev/null
        else
            cg_signal "$_dir" KILL
        fi
        nap; _n=$((_n - 1))
    done
    cg_populated "$_dir" && log "WARNING: $_dir still populated (D-state task?)"
    return 0
}

# ------------------------------------------------------------- spawn logic ---
# spawn <launcher|app> <command-string> <logfile> [terminal_mode=0|1]
# Runs the command as $RUN_USER inside its cgroup. A watcher subshell reports
# the exit back to the daemon through the FIFO, tagged with a generation id.
spawn() {
    _role=$1; _cmd=$2; _log=$3; _term=${4:-0}
    GEN=$((GEN + 1)); _g=$GEN
    case $_role in
        launcher) LAUNCHER_GEN=$_g ;;
        app)      APP_GEN=$_g ;;
    esac
    (
        exec 3<&-                      # don't leak the control FIFO to children
        if [ "$_term" = 1 ]; then
            chown "$RUN_USER" "$CONSOLE" 2>/dev/null
            exec <"$CONSOLE" >"$CONSOLE" 2>&1
            _wrap=$TTY_WRAPPER
        else
            exec </dev/null >"$_log" 2>&1
            _wrap=
        fi
        /bin/sh -c '
            echo 0 >/proc/self/oom_score_adj 2>/dev/null   # undo the daemon'"'"'s protection
            echo $$ >"$1/cgroup.procs" || exit 111          # join cgroup BEFORE exec
            exec $4 su -l -s /bin/sh "$2" -c "$3"
        ' sh "$CG_ROOT/$_role" "$RUN_USER" "$_cmd" "$_wrap"
        _rc=$?
        [ -p "$FIFO" ] && echo "exited $_role $_g $_rc" >"$FIFO"
    ) &
}

start_launcher() {
    STATE=launcher
    cg_stop "$CG_ROOT/app"           # invariant: app group empty first
    LAUNCH_T=$(uptime_s)
    [ -x "$LAUNCHER_CMD" ] || log "launcher $LAUNCHER_CMD missing or not executable"
    log "starting launcher"
    spawn launcher "$LAUNCHER_CMD" "$LAUNCHER_LOG"
}

show_loading() {
    {
        printf '\033[2J\033[H\033[?25l'
        cat <<'EOF'




                    @@@@@@                     +@@@@@
                   :@-:  @@@.                @@@% --@@
                   @@----- @@@             @@@  -----@
                   @@------ :@@@@@@@@@@@@@@@@ -------@:
                   @*---:  @@@@@@@@@@@@@@@@@@@   ----@:
                   @@-: =@@@@@@@@@@@@@@@@@@@@@@@@  --@
                   @@ #@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @
                     @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-      @@*
                    @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@* =@@@@@@@@@
                   @@@@@@  @@:  @@@@@@@@@@  :@@  @@@@ =@@@@@@@@@@@
                   @@@@@@@@@@@@# @@@@@@@@ @@@@@@@@@@@ @@ #@@ @@ @@
                   @@@+  @@@@@@@@@@@@@@@@@@@@@@@+  @@* % +@@ @@ @
                   @@@@@@@@@@@@@@@@----@@@@@@@@@@@@@@@@ @:     %
                   @@@@@@@@@@@ @@@@@  @@@@@ @@@@@@@@@@# @@@@@@@@
                    @@+ @@@@@@@    @@@@   @@@@@@@  @@@ @@@@@@@@@
                           -@@      @       ..             .
             +@@    .@@@@@@   .@@@@   @@@@@@@ *@@ @@@  #@@  @@@@@@
             @@@   :@@   @@@  @@ @@  .@@   @@ @@@.@@@@ @@@ @@
             @@.   @@@ . @@@ @@- @@. @@@  +@@ @@ @@@=@@@@.@@@ +@@@
             @@    +@@@@@@@ @@@@@@@@ @@@@@@@  @@ @@@ @@@@ .@@@@@@@
            @@@@@@   +@@:  @@@   @@@ @@@@%   @@@ @@   @@@   -@@-
EOF
    } >"$CONSOLE" 2>/dev/null
}

do_launch() {
    _rest=$1                           # "<terminal_mode 0|1> <command...>"
    _term=${_rest%% *}
    _cmd=${_rest#* }
    if [ -z "$_cmd" ] || [ "$_cmd" = "$_rest" ]; then
        log "ignoring malformed launch request"; return
    fi
    log "launching app: $_cmd"

    # Ignore exit events from whatever we are about to kill on purpose.
    LAUNCHER_GEN=0
    APP_GEN=0
    cg_stop "$CG_ROOT/launcher"
    cg_stop "$CG_ROOT/app"

    set -- $_cmd
    show_loading "${1##*/}"

    if [ "$_term" = 1 ]; then
        _out=/dev/null                 # unused: terminal mode talks to the console
        printf '\033[?25h' >"$CONSOLE" 2>/dev/null     # un-hide cursor
    else
        [ -f "$APP_LOG" ] && mv -f "$APP_LOG" "$APP_LOG.old"
        : >"$APP_LOG"; chmod 644 "$APP_LOG"
        _out=$APP_LOG
    fi

    STATE=app
    spawn app "$_cmd" "$_out" "$_term"
}

on_exit() {                            # <role> <gen> <rc>
    case $1 in
        launcher)
            [ "$2" = "$LAUNCHER_GEN" ] || return
            LAUNCHER_GEN=0
            cg_stop "$CG_ROOT/launcher"      # reap stragglers
            log "launcher exited (rc=$3)"
            [ "$STATE" = launcher ] || return
            if [ $(( $(uptime_s) - LAUNCH_T )) -lt "$MIN_LAUNCHER_UPTIME" ]; then
                # crash-loop throttle, done async so we keep serving requests
                ( exec 3<&-; sleep "$RESTART_DELAY"
                  [ -p "$FIFO" ] && echo retry >"$FIFO" ) &
            else
                start_launcher
            fi
            ;;
        app)
            [ "$2" = "$APP_GEN" ] || return
            APP_GEN=0
            cg_stop "$CG_ROOT/app"           # app's main process is gone; reap helpers
            log "app exited (rc=$3), returning to launcher"
            start_launcher
            ;;
    esac
}

# Neither of these clears APP_GEN: the watcher's exit event (main process
# gone) is what flips us back to the launcher. If the main process dies but
# helpers survive SIGTERM, on_exit() hard-kills the leftovers.
do_stop_app() {
    [ "$APP_GEN" != 0 ] && cg_signal "$CG_ROOT/app" TERM
}

do_kill_app() {
    [ "$APP_GEN" != 0 ] && cg_stop "$CG_ROOT/app"
}

shutdown_all() {
    trap '' TERM INT HUP
    log "shutting down"
    LAUNCHER_GEN=0; APP_GEN=0
    cg_stop "$CG_ROOT/launcher"
    cg_stop "$CG_ROOT/app"
    wait
    rmdir "$CG_ROOT/launcher" "$CG_ROOT/app" "$CG_ROOT" 2>/dev/null
    rm -f "$PIDFILE" "$FIFO"
    exit 0
}

# ------------------------------------------------------------------ daemon ---
daemon() {
    init_timing
    mkdir -p "$RUN_DIR" "$LOG_DIR" || exit 1
    chmod 755 "$LOG_DIR"
    rm -f "$FIFO"
    mkfifo -m 0620 "$FIFO" || exit 1
    chown "root:$(id -gn "$RUN_USER" 2>/dev/null || echo root)" "$FIFO"
    echo $$ >"$PIDFILE"
    echo -900 >/proc/self/oom_score_adj 2>/dev/null   # OOM killer: take the app, not us

    setup_cgroups || exit 1
    GEN=0; LAUNCHER_GEN=0; APP_GEN=0; STATE=launcher
    cg_stop "$CG_ROOT/launcher"       # leftovers from a previous daemon crash
    cg_stop "$CG_ROOT/app"

    trap shutdown_all TERM INT HUP
    exec 3<>"$FIFO"                     # RDWR so we never see EOF
    start_launcher

    while read -r line <&3; do
        case $line in
            "launch "*)  do_launch "${line#launch }" ;;
            "exited "*)  on_exit ${line#exited } ;;
            stop-app)    do_stop_app ;;
            kill-app)    do_kill_app ;;
            retry)       [ "$STATE" = launcher ] && [ "$LAUNCHER_GEN" = 0 ] && start_launcher ;;
            stop)        shutdown_all ;;
        esac
    done
    shutdown_all
}

# --------------------------------------------------------------------- CLI ---
case "$1" in
    start)
        if daemon_running; then echo "appd already running"; exit 0; fi
        echo "Starting appd"
        mkdir -p "$RUN_DIR"
        setsid "$SELF" daemon </dev/null >/dev/null 2>&1 &
        ;;

    daemon)
        daemon
        ;;

    stop)
        init_timing
        echo "Stopping appd"
        if daemon_running; then
            send stop
            _i=0
            while daemon_running && [ "$_i" -lt $((20 * PER_SEC)) ]; do nap; _i=$((_i + 1)); done
            if daemon_running; then
                read -r _pid <"$PIDFILE"; kill -KILL "$_pid" 2>/dev/null
            fi
        fi
        # belt and braces if the daemon was already dead
        cg_stop "$CG_ROOT/launcher"
        cg_stop "$CG_ROOT/app"
        rmdir "$CG_ROOT/launcher" "$CG_ROOT/app" "$CG_ROOT" 2>/dev/null
        rm -f "$PIDFILE" "$FIFO"
        ;;

    restart)
        "$SELF" stop
        "$SELF" start
        ;;

    status)
        if daemon_running; then echo "appd: running (pid $(cat "$PIDFILE"))"; else echo "appd: stopped"; fi
        cg_populated "$CG_ROOT/launcher" && echo "launcher cgroup: populated"
        cg_populated "$CG_ROOT/app"      && echo "application cgroup: populated"
        ;;

    launch-application)
        # $2 = command string; $3 = TERMINAL_MODE (1 = terminal, anything else = normal)
        if [ -z "$2" ]; then
            echo "usage: $0 launch-application \"<command>\" [TERMINAL_MODE=1]" >&2; exit 1
        fi
        [ "$3" = 1 ] && _term=1 || _term=0
        send "launch $_term $2"
        ;;

    stop-application)
        send stop-app
        ;;

    kill-application)
        send kill-app
        ;;

    *)
        echo "usage: $0 {start|stop|restart|status|launch-application CMD [TERMINAL_MODE]|stop-application|kill-application}" >&2
        exit 1
        ;;
esac

exit 0
