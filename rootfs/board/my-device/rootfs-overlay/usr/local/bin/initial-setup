    }
}

local language = "English"

local languages = {}

for lang in pairs(STRINGS) do
    table.insert(languages, lang)
end

table.sort(languages)

local language_native_names = {}
for _, v in ipairs(languages) do
    table.insert(language_native_names, STRINGS[v].language)
end

menui.auto_exit = false

menui:start("Welcome", function()
    local s = STRINGS[language]

    menui:page("welcome-page", {
        label = string.format("🐱 %s", s.page_welcome),
        on_enter = function(page_context)
            page_context._element_index = 2 -- force the second element to be selected by default
        end,
        on_render = function()
            menui:label("welcome_bilingual", {
                label = s.welcome_banner,
                align = "center"
            })
            menui:button("continue", {
                label = s.continue,
                align = "center",
                on_a_press_description = s.continue,
                on_a_press = function()
                    menui:push_page("language-select-page")
                end
            })
        end,
    })


    menui:page("headphone-warning-page", {
        label = string.format("⚠️ %s", s.page_headphone_warning),
        on_render = function()
            menui:label("headphone-warning-text", {
                label = s.headphone_warning
            })
            menui:button("i accept button", {
                label = s.i_accept,
                align = "center",
                on_a_press_description = s.i_accept,
                on_a_press = function()
                    -- save language settings (e.g. s.code)
                    menui:quit()
                    -- os.exit()
                end
            })
        end
    })


    menui:page("language-select-page", {
        label = string.format("💬 %s", s.page_language_select),
        on_render = function()
            menui:select("Select your language", {
                label = s.select_your_language,
                value = STRINGS[language].language,
                options = language_native_names,
                on_change = function(index, _)
                    language = languages[index]
                end
            })
            menui:button("continue", {
                label = s.continue,
                align = "center",
                on_a_press_description = s.continue,
                on_a_press = function()
                    -- menui:pop_page()
                    menui:push_page("headphone-warning-page")
                end
            })
        end,
    })
end)
