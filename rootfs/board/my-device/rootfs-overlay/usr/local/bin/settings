#!/usr/bin/env luajit
-- settings: System settings shell utility
--
--   settings get <name>          print current value
--   settings set <name> <value>  apply a value
--   settings schema [<name>]     print json schema for one/all settings
--
-- Exit codes: 0 ok, 1 error (message on stderr)

local argparse = require("argparse")
local cjson = require("cjson")
local ubus = require("ubus")

local conn

local function send_command(args)
    local res = conn:call(args.path, args.command, args.args)
    if res.status == "ok" then
        return res.response, nil
    end
    if res.response then
        return nil, res.response
    end
    return nil, "Failed, an unknown error occurred."
end

local parser = argparse("settings", "System settings interface")
parser:command_target("command")

local c_get = parser:command("get", "Print the current value of a setting.")
c_get:argument("id", "Setting id.")

local c_set = parser:command("set", "Set a setting to a new value.")
c_set:argument("id", "Setting id.")
c_set:argument("value", "New value.")

local c_schema = parser:command("schema", "Print json-style schema for all settings, or one.")
c_schema:argument("id", "Setting id."):args("?")

local args = parser:parse()

local ok, err = pcall(function()
    conn = ubus.connect()
    if not conn then
        error("Failed to connect to ubusd")
    end

    command_args = {}
    if args.value then
        command_args.value = args.value
    end

    local path
    if args.command == "schema" and not args.id then
        path = "settings"
    else
        path = string.format("settings.%s", args.id)
    end

    local response, err = send_command{path = path, command=args.command, args=command_args}
    if err then
        error(err, 0)
    end

    if type(response) == "table" then
        print(cjson.encode(response))
    else
        print(response)
    end
end)

conn:close()

if not ok then
  io.stderr:write("settings: " .. tostring(err) .. "\n")
  os.exit(1)
else
    os.exit(0)
end
