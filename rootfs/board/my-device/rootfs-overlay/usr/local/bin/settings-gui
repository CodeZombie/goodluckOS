#!/usr/bin/env luajit

local menui = require("menui")
local ubus = require("ubus")

local conn = ubus.connect()

local function send_command(path, command, args)
    if not args then args = {} end
    local res = conn:call(path, command, args)
    if res.status == "ok" then
        return res.response, nil
    end
    if res.response then
        return nil, res.response
    end
    return nil, "Failed, an unknown error occurred."
end

-- settings cache
local setting_value_cache = {}
local function get_setting_value(id)
    if not setting_value_cache[id] then
        local response, err = send_command(string.format("settings.%s", id), "get")
        if err then
            menui:push_page("error", {setting_id=id, error_message = err, mode="get"})
            response = "???"
        end
        setting_value_cache[id] = response
    end
    return setting_value_cache[id]
end
local function invalidate_setting_cache_value(id)
    setting_value_cache[id] = nil
end

-- settings schema
local settings_schema, err = send_command("settings", "schema")
if err then
    print("Failed to fetch settings schema")
    conn:close()
    error(err, 0)
end


local function set_setting(id, value)
    if not setting_value_cache[id] then
        local response, err = send_command(string.format("settings.%s", id), "set", {value=value})
        if err then
            menui:push_page("error", {setting_id=id, error_message = err, mode="set"})
            return
        end
        setting_value_cache[id] = value
    end
end

local function menui_element_from_setting(setting)
    if setting.type == "int" then
        menui:number(setting.name, {
            label = setting.name,
            value = get_setting_value(setting.id),
            min = setting.min,
            max = setting.max,
            on_change = function(new_value)
                set_setting(setting.id, new_value)
            end
        })
    elseif setting.type == "bool" then
        menui:bool(setting.name, {
            label = setting.name,
            value = setting.value,
            on_change = function(new_value)
                set_setting(setting.id, new_value)
            end,
        })
    elseif setting.type == "select" then
        menui:select(setting.name, {
            label = setting.name,
            value = setting.value,
            options = setting.options,
            on_change = function(_, new_value)
                set_setting(setting.id, new_value)
            end
        })
    end
end

local setting_ids = { "volume", "mute", "brightness", "low-battery-alert", "language" }
local date_setting_ids = { "date-day", "date-month", "date-year", "time-hour", "time-minute", "time-second" }

menui:start("Settings", function()
    menui:page("main-page", {
        label="Settings",
        on_render = function()

            menui:button("power-page-button", {
                label = "Power",
                icon = '>',
                on_a_press_description="View Power Settings",
                on_a_press = function()
                    menui:push_page("power-page")
                end,
            })

            menui:button("storage-page-button", {
                label = "Storage",
                icon = '>',
                on_a_press_description="View Storage Settings",
                on_a_press = function()
                    menui:push_page("storage-page")
                end,
            })

            for _, setting_id in ipairs(setting_ids) do
                menui_element_from_setting(settings_schema[setting_id])
            end
        end,
    })

    menui:page("error", {
        label="Error",
        on_render=function(context)
            menui:label("error-label", { label = context.error_message, align="right", icon="⚠️" })
            menui:button("back-button", {
                label = "Back",
                on_a_press_description = "Go back",
                on_a_press = function ()
                    menui:pop_page()
                end
            })
        end
    })

    menui:page("Storage", {
        on_render=function()
            if Context.tf2_mounted then
                menui:button("unmount-tf2-button", {
                    label = "Unmount TF2",
                    on_a_press_description = "Unmount TF2",
                    on_a_press = function()
                        print("Unmount TF2")
                    end
                })
            else
                menui:button("mount-tf2-button", {
                    label = "Mount TF2",
                    on_a_press_description = "Mount TF2",
                    on_a_press = function()
                        print("Mount TF2")
                    end
                })
            end

            menui:button("resize-home-button", {
                label = "Resize HOME partition",
                on_a_press_description = "Resize HOME",
                on_a_press = function()
                    print("Resize Home")
                end
            })
        end,
    })

    menui:page("Storage", {
        on_render=function()
            menui:button("power-off-button", {
                label = "Power Off",
                on_a_press_description = "Power off the device",
                on_a_press = function()
                    print("poweroff")
                end
            })
            menui:button("reboot-button", {
                label = "Reboot",
                on_a_press_description = "Reboot the device",
                on_a_press = function()
                    print("reboot")
                end
            })
        end,
    })

    menui:page("date-and-time-page", {
        label="Date & Time",
        on_render=function()
            for _, setting_id in ipairs(date_setting_ids) do
                menui_element_from_setting(settings_schema[setting_id])
            end
        end,
    })
end)

conn:close()
