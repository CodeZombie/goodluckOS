config BR2_PACKAGE_DSPERATE
	bool "dsperate"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # C++17 requirement
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  DSperate is a Nintendo DS emulator.

	  This package will automatically build the SDL2 frontend
	  if BR2_PACKAGE_SDL2 is enabled in your configuration.

	  https://github.com/beebono/DSperate

comment "dsperate needs a toolchain w/ C++, threads, gcc >= 8"
	depends on !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_8
