config BR2_PACKAGE_GALLERY
	bool "gallery"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_IMAGE
	select BR2_PACKAGE_IMGUI
	help
	  Browse the screenshots and recordings RetroArch saved.

comment "gallery needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
