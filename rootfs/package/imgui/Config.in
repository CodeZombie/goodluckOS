config BR2_PACKAGE_IMGUI
	bool "imgui"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_SDL2
	help
	  Dear ImGui: Bloat-free Graphical User interface for C++ with minimal dependencies.

	  This package builds ImGui as a shared library (.so) including
	  the SDL2 and SDLRenderer2 backends.

	  https://github.com/ocornut/imgui

comment "imgui needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
