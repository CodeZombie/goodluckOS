config BR2_PACKAGE_LIBUBOX_LUA
	bool "libubox-lua"
	depends on BR2_PACKAGE_HAS_LUAINTERPRETER
	depends on BR2_PACKAGE_LUA_5_1 || BR2_PACKAGE_LUAJIT
	depends on !BR2_STATIC_LIBS # dlopen / Lua C modules
	select BR2_PACKAGE_LIBUBOX
	help
	  Lua bindings (uloop.so) for OpenWrt's libubox event loop.

	  https://git.openwrt.org/project/libubox.git

comment "libubox-lua needs Lua 5.1 or LuaJIT and dynamic library support"
	depends on !BR2_PACKAGE_HAS_LUAINTERPRETER || \
		!(BR2_PACKAGE_LUA_5_1 || BR2_PACKAGE_LUAJIT) || \
		BR2_STATIC_LIBS
