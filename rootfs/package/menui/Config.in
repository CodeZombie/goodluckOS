config BR2_PACKAGE_MENUI
	bool "menui"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_LUAJIT
	depends on BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_TTF
	help
	  menui is an immediate-mode UI library for LuaJIT, with a
	  C++ SDL2 rendering backend accessed through the LuaJIT FFI.

	  Installs libmenui.so to /usr/lib and menui.lua to
	  /usr/share/lua/5.1.

comment "menui needs a toolchain w/ C++, LuaJIT and SDL2"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_LUAJIT || !BR2_PACKAGE_SDL2
