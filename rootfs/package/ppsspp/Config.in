config BR2_PACKAGE_PPSSPP
	bool "ppsspp (libretro core)"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9 # C++17
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_arm || BR2_aarch64 || BR2_x86_64
	select BR2_PACKAGE_ZLIB
	help
	  PPSSPP libretro core (ppsspp_libretro.so), a PSP emulator.

	  https://github.com/hrydgard/ppsspp

comment "ppsspp needs a toolchain w/ C++, threads, gcc >= 9, and a GLES provider"
	depends on BR2_arm || BR2_aarch64 || BR2_x86_64
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_9 || !BR2_PACKAGE_HAS_LIBGLES
